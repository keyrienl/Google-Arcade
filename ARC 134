#SSH into the bigquery-instance
pip install google-cloud-bigquery google-auth pandas db-dtypes --break-system-packages

#masukin contoh file python
cat << 'EOF' > query.py
from google.auth import compute_engine
from google.cloud import bigquery

credentials = compute_engine.Credentials(
    service_account_email='bigquery-qwiklab@qwiklabs-gcp-04-646bd243053a.iam.gserviceaccount.com')

query = '''
SELECT name, SUM(number) as total_people
FROM `bigquery-public-data.usa_names.usa_1910_2013`
WHERE state = 'TX'
GROUP BY name, state
ORDER BY total_people DESC
LIMIT 20
'''

client = bigquery.Client(
    project='qwiklabs-gcp-04-646bd243053a',
    credentials=credentials)

print(client.query(query).to_dataframe())
EOF

#instal
python3 query.py

